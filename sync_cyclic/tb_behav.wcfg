<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="999995fs"></ZoomStartTime>
      <ZoomEndTime time="1000001fs"></ZoomEndTime>
      <Cursor1Time time="1000000fs"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="72"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="7" />
   <wvobject fp_name="/tb/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/tb/rst" type="logic">
      <obj_property name="ElementShortName">rst</obj_property>
      <obj_property name="ObjectShortName">rst</obj_property>
   </wvobject>
   <wvobject fp_name="/tb/valid_0" type="logic">
      <obj_property name="ElementShortName">valid_0</obj_property>
      <obj_property name="ObjectShortName">valid_0</obj_property>
   </wvobject>
   <wvobject fp_name="/tb/cyclic_0" type="array">
      <obj_property name="ElementShortName">cyclic_0[31:0]</obj_property>
      <obj_property name="ObjectShortName">cyclic_0[31:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/tb/valid_1" type="logic">
      <obj_property name="ElementShortName">valid_1</obj_property>
      <obj_property name="ObjectShortName">valid_1</obj_property>
   </wvobject>
   <wvobject fp_name="/tb/cyclic_1" type="array">
      <obj_property name="ElementShortName">cyclic_1[31:0]</obj_property>
      <obj_property name="ObjectShortName">cyclic_1[31:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/tb/i" type="array">
      <obj_property name="ElementShortName">i[31:0]</obj_property>
      <obj_property name="ObjectShortName">i[31:0]</obj_property>
   </wvobject>
</wave_config>
